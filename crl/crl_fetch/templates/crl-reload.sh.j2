#!/bin/bash
# {{ ansible_managed }}
#
# Reload services that hold the CRL open.
#
# Invoked as ExecStartPost=+ from crl-fetch.service, which means systemd runs
# it as root outside the unit's sandbox. sudo is not an option here:
# crl-fetch.service sets NoNewPrivileges=true, which blocks setuid binaries
# entirely. The fetch itself remains unprivileged.
#
# ExecStartPost runs after every SUCCESSFUL fetch, including the common case
# where nothing changed. The checksum comparison below is what makes this a
# no-op on those runs — services are only reloaded when the CRL actually moved.

set -uo pipefail

CRL="{{ crl_fetch_publish_dir }}/{{ crl_fetch_filename }}"
MARKER="{{ crl_fetch_state_dir }}/last-reloaded-sum"

log() { logger -t crl-reload -p "daemon.$1" -- "$2"; printf '[%s] %s\n' "$1" "$2" >&2; }

[ -f "$CRL" ] || { log info "no CRL at ${CRL}; nothing to reload"; exit 0; }

CUR_SUM="$(sha256sum "$CRL" | cut -d' ' -f1)"
LAST_SUM="$(cat "$MARKER" 2>/dev/null || echo none)"

if [ "$CUR_SUM" = "$LAST_SUM" ]; then
    exit 0
fi

FAILED=0
{% for svc in crl_fetch_reload_services %}
if systemctl is-active --quiet {{ svc }}; then
    if systemctl reload {{ svc }}; then
        log notice "reloaded {{ svc }}"
    else
        log err "reload of {{ svc }} FAILED — it is still using the previous CRL"
        FAILED=1
    fi
else
    log info "{{ svc }} is not running; skipping reload"
fi
{% endfor %}

# The marker is only advanced when every reload succeeded. A failed service is
# therefore retried on the next fetch rather than being silently skipped
# forever because the checksum already matched.
if [ "$FAILED" -eq 0 ]; then
    printf '%s\n' "$CUR_SUM" > "$MARKER"
    exit 0
fi

log err "one or more reloads failed; will retry on the next fetch"
exit 1
