# {{ ansible_managed }}
#
# WHAT to run. This unit has no schedule — crl-fetch.timer triggers it.
# Deliberately no [Install] section: this service should only ever be started
# by its timer or by hand, never wired into a boot target.

[Unit]
Description=Fetch and validate the FreeIPA CRL
Documentation=file://{{ crl_fetch_home }}
# The fetch crosses the WAN, so wait for real connectivity rather than just
# for the network stack to exist.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ crl_fetch_user }}
Group={{ crl_fetch_group }}
ExecStart=/usr/local/sbin/crl-fetch
{% if crl_fetch_reload_services | length > 0 %}

# The '+' prefix runs this as root, outside the sandbox below. Required because
# NoNewPrivileges=true blocks sudo, so an unprivileged crl-fetch cannot reload
# a service by any other route. The script itself is a no-op unless the CRL
# checksum actually changed.
ExecStartPost=+/usr/local/sbin/crl-reload
{% endif %}

# The script's own curl timeout is {{ crl_fetch_timeout }}s. Give systemd
# headroom beyond that so a slow-but-progressing fetch is not killed mid-run.
TimeoutStartSec={{ (crl_fetch_timeout | int) + 300 }}

# ── Sandboxing ───────────────────────────────────────────────────────────
# This service reaches across the WAN and writes into a directory a web server
# will later serve. Keep what it can touch to the minimum.
#
# ProtectSystem=strict makes the entire filesystem read-only, so ReadWritePaths
# below is not optional — anything missing from it produces a "Read-only file
# system" error at runtime, not at deploy time.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths={{ crl_fetch_staging_dir }} {{ crl_fetch_state_dir }} {{ crl_fetch_publish_dir }} {{ crl_fetch_log_dir }}

# Hidden from this unit regardless of file ownership. If crl_push shares this
# service account, its SSH private key lives in one of these paths — and this
# process, which parses untrusted bytes, must not be able to read it.
# ProtectSystem=strict only makes the filesystem read-only; this makes it unreadable.
{% for path in crl_fetch_inaccessible_paths | default([]) %}
InaccessiblePaths=-{{ path }}
{% endfor %}
